# Environment Mode
ASPNETCORE_ENVIRONMENT=Production

# Database Connection (Render Managed PostgreSQL or Local Connection String)
DATABASE_URL=postgres://pharmpos_user:password@localhost:5432/pharmpos

# JWT Security
Jwt__Key=REPLACE_WITH_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=PharmPOS
Jwt__Audience=PharmPOS
Jwt__ExpiryHours=8

# CORS (Frontend URL allowed to connect to API)
Cors__AllowedOrigins__0=http://localhost:5173

# Supabase Storage (For File Uploads & Facility Logos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# OpenRouter Clinical AI Key & Free Model Routing
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Frontend API URL (React Vite app configuration)
VITE_API_URL=http://localhost:5000
